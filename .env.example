# ===== mcdx-docker 部署配置示例 =====
# 复制为 .env 后按需修改，然后 docker compose up -d --build

# 网页访问端口（默认 33333）
MDCX_WEB_PORT=33333

# 宿主机媒体挂载区目录：该目录下的内容在容器内以 /media/<名称> 出现。
# 例如想把 /srv/media 里的片子给容器用：MDCX_SMB_BASE=/srv/media
# （硬链接整理要求源与目标库在同一文件系统，挂载时注意）
MDCX_SMB_BASE=/vol1/smb

# 整理目标库根目录（容器内路径，默认 /media 下）
MDCX_LIBRARY_ROOT=/media

# 日志级别
MDCX_LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai